# Clerk stays. These are site sign-in, not the CMS.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Payload content store. Postgres you run. No Sanity Content Lake.
DATABASE_URI=postgresql://life:life@localhost:5432/life
PAYLOAD_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Set PAYLOAD_DB_PUSH=false after the first boot once migrations exist.
PAYLOAD_DB_PUSH=true

# Images. Pick one. If both are empty, files land in life-app/media.
# S3-compatible bucket you control:
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# Or Vercel Blob:
# BLOB_READ_WRITE_TOKEN=

# Still required while community posts, comments, and Clerk user profiles live in Sanity.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2025-07-05
SANITY_ADMIN_API_TOKEN=
